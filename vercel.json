{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_BROWSER_ONLY=1 npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/video.mjs": {
      "maxDuration": 300,
      "includeFiles": "{bin/yt-dlp,node_modules/ffmpeg-static/ffmpeg}"
    }
  }
}
